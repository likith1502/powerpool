# ==========================================
# PowerPool - Core & Backend Configuration
# ==========================================

# Database path (SQLite file location)
DB_PATH=data/powerpool.db

# Grid / Feeder physical constraints
FEEDER_CAPACITY_KW=170.0

# Resident response behavior (expected share of residents accepting a nudge: 0.0 to 1.0)
COMPLIANCE=0.65

# Time-of-Day Tariff (Rs/kWh)
# Backend uses PEAK_TARIFF & OFFPEAK_TARIFF; Member A aliases (PEAK_TARIFF_RS_PER_KWH, OFFPEAK_TARIFF_RS_PER_KWH) are supported
PEAK_TARIFF=9.0
OFFPEAK_TARIFF=6.0
PEAK_TARIFF_RS_PER_KWH=9.0
OFFPEAK_TARIFF_RS_PER_KWH=6.0

# Grid carbon intensity factor (kg CO2 / kWh)
# Backend uses CO2_PER_KWH; Member A alias (CO2_FACTOR_KG_PER_KWH) is supported
CO2_PER_KWH=0.71
CO2_FACTOR_KG_PER_KWH=0.71

# Optional API Keys and Integrations (leave empty for deterministic offline operation)
API_URL=http://127.0.0.1:8000
TELEGRAM_TOKEN=
AI_NUDGE_PERSONALIZATION=false
ANTHROPIC_API_KEY=

# Forecast data source flag:
# 'false' = use real Member A pipeline precomputed forecast from SQLite (default when forecast has 288 slots)
# 'true'  = force mock mode (e.g. for offline stubbing or tests)
MOCK_DATA=false

# ==========================================
# PowerPool - Data & ML Pipeline Configuration
# ==========================================

POWERPOOL_NUM_HOUSEHOLDS=100
POWERPOOL_DAYS=30
POWERPOOL_SLOT_MINUTES=15

# Open-Meteo weather coordinates (Hyderabad default)
OPEN_METEO_LAT=17.3850
OPEN_METEO_LON=78.4867
OPEN_METEO_TIMEOUT_SECONDS=10

# Trained model path
DEMAND_MODEL_PATH=ml/models/demand_model.txt

# Random seed for reproducible generation
RANDOM_SEED=42

# Feeder stress safety margin (kW)
STRESS_MARGIN_KW=0.0
